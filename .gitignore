# Temporary files.
temp/
tmp/

# Python bytecode and caches.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local environment files.
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging/build outputs.
build/
dist/
*.egg-info/

# Local artifacts generated by CLI runs and skills.
/data/
/outputs/
.claude/skills/*/outputs/
.claude/skills/*/scripts/__pycache__/
.claude/workspaces/

# Local editor, OS, and runtime noise.
.DS_Store
.idea/
.vscode/
*.log
